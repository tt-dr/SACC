APP_NAME=SACC API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=mysql+asyncmy://sacc:sacc_password@mysql:3306/sacc?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=43200
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_SIZE=10485760

OSS_ENDPOINT=https://oss-cn-nanjing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_BUCKET_PREFIX=sacc/
OSS_PUBLIC_BASE_URL=
